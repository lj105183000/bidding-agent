# 复制为 .env 并填入真实值（.env 已被 gitignore，密钥不入库）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<你的 postgres 密码>
POSTGRES_DB=chatbot
NEO4J_AUTH=neo4j:<你的 neo4j 密码>
NEO4J_DATABASE=neo4j
VLLM_MODEL_DIR=D:/NLP_learning/router_finetune/output

# ---- 对象存储（MinIO，S3 兼容） ----
# 存上传的原始文件、提取出的图片、导出的报告。
# 控制台 http://127.0.0.1:9001 （9000 是 S3 API，应用连它）
# 密码至少 8 位。生成：python -c "import secrets,string;print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(20)))"
MINIO_ROOT_USER=bidminio
MINIO_ROOT_PASSWORD=
