# 复制为 .env 后填写（.env 已被 .gitignore 屏蔽，永不入库）
# 完整配置项与默认值见 docs/开发文档.md §2.3

# ---- 必需 ----
QDRANT_URL=
QDRANT_API_KEY=
DEEPSEEK_API_KEY=

# ---- LLM ----
LLM_PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_THINKING_MODEL=          # 深度思考专用推理模型，留空回退提示词注入

ZHIPU_API_KEY=
# ZHIPU_MODEL=glm-4.7-flashx
# ZHIPU_VISION_MODEL=glm-4.6v-flashx
# ZHIPU_THINKING_MODEL=

# ---- 本地模型（OpenAI 兼容） ----
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_API_KEY=EMPTY
# VLLM_MODEL=deepseek-r1-0528-qwen3-8b
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=ollama
# OLLAMA_MODEL=deepseek-r1:8b

# ---- 向量库 ----
# QDRANT_COLLECTION=bid_qa
# QDRANT_VECTOR_SIZE=512
# QDRANT_TIMEOUT=30

# ---- 知识图谱（Neo4j） ----
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
# NEO4J_DATABASE=neo4j

# ---- 结构化数据库（PostgreSQL） ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=chatbot

# ---- 联网搜索 ----
TAVILY_API_KEY=
# EXA_API_KEY=

# ---- API 服务 ----
# API_HOST=0.0.0.0
# API_PORT=8001
# CORS_ORIGINS=                      # 逗号分隔；* 允许所有；空 = 本地 3000 端口

# ---- 限流 ----
# RATE_LIMIT_MAX=30
# RATE_LIMIT_WINDOW=60

# ---- 模型下载镜像（国内必需） ----
HF_ENDPOINT=https://hf-mirror.com
