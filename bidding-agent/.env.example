# 复制为 .env 后填写（.env 已被 .gitignore 屏蔽，永不入库）
# 完整配置项与默认值见 docs/开发文档.md §2.3

# ---- 必需 ----
QDRANT_URL=
QDRANT_API_KEY=
DEEPSEEK_API_KEY=

# ---- LLM ----
LLM_PROVIDER=deepseek
# 模型名：官方口径请用 deepseek-flash / deepseek-v4-pro。
# 旧名 deepseek-chat / deepseek-reasoner 将于 2026-07-24 15:59 UTC 退役。
DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# ---- 深度思考（聊天窗口的「深度思考」开关） ----
#
# ★ 重要：DeepSeek 已**没有独立推理模型名**（2026-04-24 发布 V4 后取消）。
#   现在只有 deepseek-flash / deepseek-v4-pro，两者都由**请求参数**
#   {"thinking": {"type": "enabled"}} 控制思考模式。
#   旧名 deepseek-reasoner 将于 2026-07-24 15:59 UTC 退役，且它只映射到 Flash。
#
# 三种生效方式，按优先级：
#
#   ① DEEPSEEK_THINKING_ENABLED=true  → 开关打开时发 thinking 参数，
#      拿到**真思维链**（delta.reasoning_content，前端单独折叠展示）
#   ② DEEPSEEK_THINKING_MODEL=<模型名> → 切到该模型（用于**确有独立推理模型**
#      的部署，如本地 vLLM 上单独部署的 R1；DeepSeek 官方已不适用）
#   ③ 两者都没配 → 回退：往 system 提示注入三步分析指令
#      （拆解问题 → 多角度分析 → 给出结论），并放宽输出 token 上限
#
# 无论走哪条，都只在用户打开「深度思考」开关的那一次请求生效，
# 普通请求不受影响（不额外付出思维链的延迟与 token）。
#
DEEPSEEK_THINKING_ENABLED=false
# DEEPSEEK_THINKING_MODEL=

ZHIPU_API_KEY=
# ZHIPU_MODEL=glm-4.7-flashx
# ZHIPU_VISION_MODEL=glm-4.6v-flashx
# ZHIPU_THINKING_MODEL=glm-4.7-thinking
#
# 深度思考的输出预算（token）。两条路径都用它：
#   - 真推理模型：思维链 + 正文共享该预算，故必须比普通请求宽
#   - 提示词注入：全部内容都在正文里，同样需要更宽，否则会写到一半被截断
# 本地小模型（ollama/vllm）的上下文窗口可能远小于 8192，此时要调小。
# MAX_TOKENS_DEEP=8192

# ---- 本地模型（OpenAI 兼容） ----
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_API_KEY=EMPTY
# VLLM_MODEL=deepseek-r1-0528-qwen3-8b
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=ollama
# OLLAMA_MODEL=deepseek-r1:8b

# ---- 向量库 ----
# QDRANT_COLLECTION=bid_qa
# QDRANT_VECTOR_SIZE=512
# QDRANT_TIMEOUT=30

# ---- 知识图谱（Neo4j） ----
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
# NEO4J_DATABASE=neo4j

# ---- 结构化数据库（PostgreSQL） ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=chatbot

# ---- 数据中台（只读资产目录 / 血缘 / 质量报告） ----
# 目录与血缘端点的进程内缓存秒数。0 = 关闭缓存。
# 目录来自静态注册表，正常不会变；TTL 只是让“改了注册表后”最多等这么久生效。
# DATA_CATALOG_CACHE_SECONDS=60
# 质量报告保留天数与 /api/data/quality/latest 缓存秒数。
# DATA_QUALITY_RETENTION_DAYS=30
# DATA_QUALITY_CACHE_SECONDS=30
#
# ---- 数据中台：轻量调度（独立进程 `python main.py scheduler`） ----
# 常驻调度默认关闭；只做幂等的法规增量 / 质量扫描 / 目录快照。
# 破坏性的 ingest / pg --force / graph --clear 永远人工执行。
# DATA_SCHEDULER_ENABLED=0
# DATA_SCHEDULER_TIMEZONE=Asia/Shanghai
# DATA_SCHEDULER_REGULATIONS_CRON=30 3 * * *
# DATA_SCHEDULER_QUALITY_CRON=15 */6 * * *
# DATA_SCHEDULER_CATALOG_CRON=0 4 * * *
# DATA_SCHEDULER_MAX_INSTANCES=1
# DATA_SCHEDULER_COALESCE=1
# DATA_SCHEDULER_MISFIRE_GRACE_SECONDS=300

# ---- 联网搜索 ----
TAVILY_API_KEY=
# EXA_API_KEY=

# ---- API 服务 ----
# API_HOST=0.0.0.0
# API_PORT=8001
# 前端跨域白名单（逗号分隔；* 允许所有；留空 = localhost:3000/5173）
#CORS_ORIGINS=

# ---- 限流 ----
# 分层配额（每窗口请求数 / 窗口秒数）。不设则用代码里的默认值：
#   heavy   10/60   抽取、视觉、文档解析、报告生成（单次就很贵）
#   llm     30/60   问答、比对、合规检查、联网搜索（走大模型）
#   context 120/60  只读统计、图谱、会话（正常翻页会打不少请求）
# 健康检查与 /api/logs 属 none 层，**永不限流**（限流探活会让编排器误判并重启）
#RATE_LIMIT_HEAVY=10
#RATE_LIMIT_HEAVY_WINDOW=60
#RATE_LIMIT_LLM=30
#RATE_LIMIT_LLM_WINDOW=60
#RATE_LIMIT_CONTEXT=120
#RATE_LIMIT_CONTEXT_WINDOW=60

# ★ 反向代理部署时**必须**配置，否则限流不按客户端生效。
#
# 本服务若跑在 nginx / Caddy / Traefik / 云 LB / Docker 端口映射之后，
# 那么 `request.client.host` 是**代理的 IP**，所有用户会共用同一个限流桶——
# 结果是一个用户打满配额后，**全站用户一起被拒**。
#
# 填入代理的直连 IP（支持前缀匹配，容器网络建议用网段前缀）：
#   TRUSTED_PROXIES=172.18.0.1
#   TRUSTED_PROXIES=172.18.,10.0.
#
# ⚠️ 留空 = **不信任任何转发头**（安全默认值）。这是对的：
#    `X-Forwarded-For` 是客户端可伪造的头，无条件采信等于没有限流。
#    只有直连方确实在可信列表里时，才会去读它。
# ⚠️ 不要用 `*`（信任所有）除非本服务**只能**被代理访问，
#    否则任何人都能伪造 XFF 绕过限流。
#TRUSTED_PROXIES=

# ---- 日志 ----
# 输出格式：json（结构化，容器/文件采集用）/ text（人类可读，本地开发用）
# 不设则自动判断：stderr 是终端 → text，否则 → json
#LOG_FORMAT=json
# 日志级别：DEBUG / INFO / WARNING / ERROR
#LOG_LEVEL=INFO

# ---- 模型下载镜像（国内必需） ----
HF_ENDPOINT=https://hf-mirror.com

# ---- Langfuse（可选：LLM 可观测性） ----
# 不配 = 完全关闭（不联网、不发数据），只保留本地 /api/metrics 与耗时面板。
#
# 需要先在 Langfuse 建项目拿 key：
#   Langfuse Cloud  https://cloud.langfuse.com  → Settings → API Keys
#   自建实例        把 LANGFUSE_BASE_URL 指向你的地址
#
# ★ 变量名是 LANGFUSE_BASE_URL（不是 LANGFUSE_HOST）
#   两个都认，但以 BASE_URL 优先——它是官方 SDK 更常用的写法。
# ★ 数据会离开本机（prompt 与回答会发到 Langfuse）。
#   招投标场景若含敏感信息，请先确认合规，或保持不配。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 留空 = SDK 默认（https://cloud.langfuse.com）；自建/区域实例请填
# LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com

# ★ 成本估算单价表覆盖（JSON，美元/百万 token；**合并**而非替换）。
#   内置表已含 deepseek-flash 峰值价（input 0.30 / output 1.20 / cached_input 0.006）。
#   只在空闲时段跑评测时，可覆盖成半价：
# LANGFUSE_PRICE_TABLE='{"deepseek-flash":{"input":0.15,"output":0.60,"cached_input":0.003}}'

# ---- 评测裁判模型（ragas LLM-as-Judge，可选） ----
# ragas 的裁判**默认用智谱 GLM**，与生成方（LLM_PROVIDER=deepseek）**不同家**，
# 以规避自评偏差（self-preference bias：同族模型倾向给同族输出高分，
# 会让指标系统性偏高，做 A/B 或回归门禁时误判）。
#
# ★ 若你把 LLM_PROVIDER 改成 zhipu，裁判与生成就同源了 —— 评测会打印警告，
#   此时请把裁判换成第三家：
# RAGAS_JUDGE_MODEL=glm-5.3-flash

# ★ 判分失败自动重试次数（默认 3）
#   智谱 GLM 在 ragas 要求的结构化输出上明显弱于 DeepSeek：
#   glm-5.3-flash 单次判分成功率仅约 0.67（失败原因：ragas 抽不出陈述 → NaN）。
#   但同一份输入重试就能成功，故加 3 次尝试把成功率拉到 ≈0.96（实测 8/8）。
#   提高它会增加裁判调用次数（只在失败样本上多花）。
# RAGAS_JUDGE_ATTEMPTS=3

# ---- Agent 答案核对修复（可选） ----
# 1 = 核对发现未支持的条款号/数字/法规名时，在 done 前再调一次 LLM 定向修复
#     （会发 reset 重发全文；约 1/4 请求多一次调用）。
# 0/不配 = 只核对、不修复。Eval Gate 的 agent 线显式设为 1。
# AGENT_VERIFY_REPAIR=0

# ---- RAG 在线评测（真实请求采样） ----
# 从**真实请求**里采集质量信号，与 eval/ 的离线评测互补：
#   离线 = 固定测试集 + LLM 裁判，有参考答案 → 能测"答得对不对"
#   在线 = 真实请求 + 已有信号，无参考答案 → 测不了"对不对"，但覆盖真实分布
#
# ★ 在线评测**不能拖慢请求**：确定性指标是纯函数提取（零开销），
#   写盘走后台线程，队列满时丢弃而不是阻塞。
#
# 开关（默认开）与采样率（默认 0.2 = 20%）
# RAG_ONLINE_EVAL=1
# RAG_ONLINE_EVAL_RATE=0.2
#
# 样本文件路径（默认 eval/online_samples.jsonl）
# RAG_ONLINE_EVAL_PATH=
#
# ★ LLM 裁判采样率（默认 0 = 关闭）
#   开启后按比例抽样调用 LLM 判分，会**产生额外 API 成本**，故默认关闭。
# RAG_ONLINE_EVAL_JUDGE_RATE=0
#
# 查看聚合：GET /api/eval/online

# ─────────────── 对象存储（MinIO，S3 兼容） ───────────────
# 存上传的原始文件、提取出的图片、导出的报告 —— postgres/qdrant/neo4j 都不适合存大文件。
# 部署见 docker-compose.yml 的 `minio` 服务（数据在命名卷 bid_minio_data）。
#
# 控制台：http://127.0.0.1:9001 （用下面的账号密码登录）
#   9000 = S3 API，应用连这个
#   9001 = Web 控制台，浏览器用
#
# ★ 密码至少 8 位。生成方式（避免手敲弱口令）：
#     python -c "import secrets,string;print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(20)))"
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ROOT_USER=bidminio
MINIO_ROOT_PASSWORD=
# 是否走 https（本地为 false；接了 TLS 反代再改 true）
MINIO_SECURE=false
# 默认 bucket（不存在时由应用自动创建）
MINIO_BUCKET=bidding-files
