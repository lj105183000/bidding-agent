# 复制为 .env 后填写（.env 已被 .gitignore 屏蔽，永不入库）
# 完整配置项与默认值见 docs/开发文档.md §2.3

# ---- 必需 ----
QDRANT_URL=
QDRANT_API_KEY=
DEEPSEEK_API_KEY=

# ---- LLM ----
LLM_PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-v4-flash
ZHIPU_API_KEY=

# ---- 模型下载镜像（国内必需） ----
HF_ENDPOINT=https://hf-mirror.com

# ---- 可选：图谱 / 数据库 / 联网 ----
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=chatbot
TAVILY_API_KEY=
